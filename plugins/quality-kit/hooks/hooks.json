{
  "description": "Quality Kit: a summary when a session starts; before a tool runs, a person's approval for an exception, and a block on edits to generated files and on installs of packages that do not exist or are too new; and a check before Claude stops.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/qk\" hook session-start",
            "timeout": 150
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/qk\" hook pre-tool-use",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/qk\" hook stop",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
