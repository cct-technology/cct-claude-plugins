# Runs the Quality Kit checks on each pull request, and keeps one comment on it up to date.
name: Quality Kit
on: pull_request
jobs:
  quality:
    uses: cct-technology/cct-claude-plugins/.github/workflows/quality.yml@[[.Ref]]
    permissions: { contents: read, pull-requests: write }
    # While cct-technology/cct-claude-plugins is private, this secret is a token that can read its releases.
    secrets: { QK_RELEASE_TOKEN: "${{ secrets.QK_RELEASE_TOKEN }}" }
